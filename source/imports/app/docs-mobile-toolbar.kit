<!-- MOBILE TOOLBAR -->

<!-- <button class="ql-header" value="1"      ></button>
<button class="ql-header" value="2"      ></button>
<button class="ql-header" value="3"      ></button> -->

<button class="cryptee-fonts-button" onclick="toggleFontsPanel();"><i class="ri-font-size"></i></button>

<!-- removing, since they're in the top menu now -->

<button class="ql-bold"                  ></button>
<button class="ql-italic"                ></button>
<button class="ql-underline"             ></button>
<button class="ql-strike"                ></button>
<button class="ql-link"                  ></button>

<button class="ql-list"   value="check"  ></button>
<button class="ql-list"   value="bullet" ></button>
<button class="ql-list"   value="ordered"></button>

<!-- only here to create virtual click events. since the desktop top bar isn't initialized in mobile, the picture ql-image button doesn't work-->
<button class="ql-image hidden-offline"></button>
<button class="cryptee-new-table hidden-offline" title="New Table"><i class="ri-table-2"></i></button>

<!-- <select class="ql-color" ></select> -->
<!-- <select class="ql-background" ></select> -->

<span   class="ql-hr"     value="divider"><i class="ri-separator"></i></span>
<button class="ql-blockquote"            ></button>

<button class="ql-script"    value="sub"            title="Sub"></button>
<button class="ql-script"    value="super"          title="Super"></button>

<button class="ql-indent" value="-1"     ></button>
<button class="ql-indent" value="+1"     ></button>

<button class="ql-align"     value=""       ></button>
<button class="ql-align"     value="center" ></button>
<button class="ql-align"     value="right"  ></button>
<button class="ql-align"     value="justify"></button>
<button class="ql-direction" value="rtl"    ></button>

<button class="ql-code-block"            ></button>
<button class="cryptee-new-comment" onclick="newComment();"><svg width="20" height="19.5" xmlns="http://www.w3.org/2000/svg" viewBox='0 0 20 20'><g><path d="M9 7L9 4 11 4 11 7 14 7 14 9 11 9 11 12 9 12 9 9 6 9 6 7z"/><path d="M3.763 14H18V2H2v13.385L3.763 14zm.692 2L0 19.5V1a1 1 0 0 1 1-1h18a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1H4.455z"/></g></svg></button>
<button class="ql-clean"  value="clean"  ></button>

<button alt="Help" onclick="showModal('modal-help')"><i class="ri-question-mark"></i></button>

<!-- undo will be appended here in js -->