<div class="view hidden view-upgrade" id="photos-view-upgrade">
    <h3>UPGRADE</h3>
    <button class="close" onclick="hideActiveView();"><img src="../assets/cross.svg" alt="close" title="close message" draggable="false"></button>
    <div class="view-content">
        <p class="white">
            for the price of a cup of coffee,<br>
            get yourself more storage for all your<br>
            stuff, and the ability to share them.
            <br><br class="hidden-below-tablet">
            <span style="color: #aaa;" class="hidden-below-tablet">+ you'd be helping us make<br>the internet a safer place</span>
        </p>

        <button onclick="goToUpgrade();">get more storage</button>
    </div>
</div>

<div class="view hidden view-upgrade" id="photos-view-upgrade-sharing">
    <h3>UPGRADE</h3>
    <button class="close" onclick="hideActiveView();"><img src="../assets/cross.svg" alt="close" title="close message" draggable="false"></button>
    <div class="view-content">
        <p class="white">
            for the price of a cup of coffee,<br>
            get more storage for all your stuff<br>
            and unlock the ability to share<br>
            photos &amp; videos with your loved ones.
            <br><br class="hidden-below-tablet">
            <span style="color: #aaa;" class="hidden-below-tablet">+ you'd be helping us make<br>the internet a safer place</span>
        </p>

        <button onclick="goToUpgrade();">get more storage &amp; start sharing</button>
    </div>
</div>