<article id="index-docs-intro">

    <aside></aside> <!-- spacing -->

    <section class="grid-half">
        <b></b>
        <div>
            <h2>ALL YOUR DOCS, JOURNALS &AMP; NOTES ENCRYPTED</h2>
            <p class="lowercase justify">
                Cryptee's encrypted document editor is great for writing private &amp; personal documents, journals and notes.
                Your writing is always encrypted
                in a way that we can't read - and no one else can either.
            </p>
        </div>
    </section>

    <aside></aside> <!-- spacing -->

</article>

<article style="padding: 8rem 0" id="index-docs-features">
    <aside></aside> <!-- spacing -->
    <section class="grid-half index-grid-features">

        <div class="feature">
            <p>cross-link your docs &amp; files</p>
            <p aria-disabled="true">with attachments &amp; cross-links</p>
        </div>

        <picture>
            <source type="image/webp" srcset="../imgs/2026/docs_side_by_side-576w.webp 1x, ../imgs/2026/docs_side_by_side-1152w.webp 2x, ../imgs/2026/docs_side_by_side-1728w.webp 3x, ../imgs/2026/docs_side_by_side-2304w.webp 4x">
            <img    type="image/jpeg"  src="../imgs/2026/docs_side_by_side-576w.jpg" srcset="../imgs/2026/docs_side_by_side-576w.jpg 1x, ../imgs/2026/docs_side_by_side-1152w.jpg 2x, ../imgs/2026/docs_side_by_side-1728w.jpg 3x, ../imgs/2026/docs_side_by_side-2304w.jpg 4x" alt="Cryptee Docs" loading="lazy">
        </picture>

        <div class="feature">
            <p>use inline #hashtags</p>
            <p aria-disabled="true">to categorize your ideas quickly</p>
        </div>

        <div class="feature">
            <p>use markdown &amp; hotkeys</p>
            <p aria-disabled="true">to write privately like a pro</p>
        </div>

        <div class="feature">
            <p>use on all your devices</p>
            <p aria-disabled="true">with encrypted &amp; instant sync</p>
        </div>

        <b class="full"></b>

        <picture>
            <source type="image/webp" srcset="../imgs/2026/docs_formulas_and_code-576w.webp 1x, ../imgs/2026/docs_formulas_and_code-1152w.webp 2x, ../imgs/2026/docs_formulas_and_code-1728w.webp 3x, ../imgs/2026/docs_formulas_and_code-2304w.webp 4x">
            <img    type="image/jpeg"  src="../imgs/2026/docs_formulas_and_code-576w.jpg" srcset="../imgs/2026/docs_formulas_and_code-576w.jpg 1x, ../imgs/2026/docs_formulas_and_code-1152w.jpg 2x, ../imgs/2026/docs_formulas_and_code-1728w.jpg 3x, ../imgs/2026/docs_formulas_and_code-2304w.jpg 4x" alt="Cryptee Docs" loading="lazy">
        </picture>

        <div class="feature">
            <p>code &amp; write math in a breeze</p>
            <p aria-disabled="true">with inline-code &amp; katex math</p>
        </div>

        <div class="feature">
            <p>hide your documents</p>
            <p aria-disabled="true">with 'ghost' folders</p>
        </div>

        <div class="feature">
            <p>jump between chapters</p>
            <p aria-disabled="true">with table of contents</p>
        </div>

        <div class="feature">
            <p>use offline (as well as online)</p>
            <p aria-disabled="true">and sail away without worries</p>
        </div>

        <b class="full"></b>

    </section>
    <aside></aside> <!-- spacing -->

    <aside></aside> <!-- spacing -->
    <section class="grid-half index-grid-features">

        <div class="feature">
            <p>use continuous or print layout</p>
            <p aria-disabled="true">to print precisely what you see</p>
        </div>

        <picture>
            <source type="image/webp" srcset="../imgs/2026/docs_offline-576w.webp 1x, ../imgs/2026/docs_offline-1152w.webp 2x, ../imgs/2026/docs_offline-1728w.webp 3x, ../imgs/2026/docs_offline-2304w.webp 4x">
            <img    type="image/jpeg"  src="../imgs/2026/docs_offline-576w.jpg" srcset="../imgs/2026/docs_offline-576w.jpg 1x, ../imgs/2026/docs_offline-1152w.jpg 2x, ../imgs/2026/docs_offline-1728w.jpg 3x, ../imgs/2026/docs_offline-2304w.jpg 4x" alt="Cryptee Docs" loading="lazy">
        </picture>

        <div class="feature">
            <p>save documents as pdf files</p>
            <p aria-disabled="true">with encrypted pdf exports</p>
        </div>

        <div class="feature">
            <p>use rtl languages</p>
            <p aria-disabled="true">and feel right at home</p>
        </div>

        <div class="feature">
            <p>open &amp; import evernote notes</p>
            <p aria-disabled="true">with built-in evernote support</p>
        </div>

        <b class="full"></b>

        <picture>
            <source type="image/webp" srcset="../imgs/2026/docs_tables_checklists-576w.webp 1x, ../imgs/2026/docs_tables_checklists-1152w.webp 2x, ../imgs/2026/docs_tables_checklists-1728w.webp 3x, ../imgs/2026/docs_tables_checklists-2304w.webp 4x">
            <img    type="image/jpeg"  src="../imgs/2026/docs_tables_checklists-576w.jpg" srcset="../imgs/2026/docs_tables_checklists-576w.jpg 1x, ../imgs/2026/docs_tables_checklists-1152w.jpg 2x, ../imgs/2026/docs_tables_checklists-1728w.jpg 3x, ../imgs/2026/docs_tables_checklists-2304w.jpg 4x" alt="Cryptee Docs" loading="lazy">
        </picture>

        <div class="feature">
            <p>open and edit docx, pdf &amp; odt files</p>
            <p aria-disabled="true">with built-in word, odt &amp; pdf support</p>
        </div>

        <div class="feature">
            <p>open &amp; save markdown files</p>
            <p aria-disabled="true">with built-in markdown support</p>
        </div>

        <div class="feature">
            <p>use checkboxes &amp; tables</p>
            <p aria-disabled="true">to keep track of things to do</p>
        </div>

        <div class="feature">
            <p>quickly reference pdf &amp; ebooks</p>
            <p aria-disabled="true">with side-by-side view</p>
        </div>

    </section>
    <aside></aside> <!-- spacing -->
</article>
