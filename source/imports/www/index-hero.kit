<article id="hero">

    <!-- this is intentionally mapped out as 2x being the original size, 3x -> 2x, and 4x -> 3x -->
    <!-- on retina displays these display a bit better due to the roundedness of the image i think -->
    <!-- we want these sharp. not shit. -->

    <!-- <img id="hero-img" class="hero" type="image/jpeg" src="../imgs/hero/hero@2x.jpg"  srcset="../imgs/hero/hero@3x.jpg 2x, ../imgs/hero/hero@4x.jpg 3x" alt="Cryptee Encrypted Docs & Photos"> -->
    <!--<aside></aside>-->

    <picture>
        <source type="image/webp"
            sizes="(min-width: 1420px) 133.35vw, (min-width: 900px) calc(175.4vw - 675px), (min-width: 720px) calc(180vw - 496px), calc(92vw + 312px)"
            srcset="
    			../imgs/2026/hero-576w.webp 576w,
    			../imgs/2026/hero-1152w.webp 1152w,
    			../imgs/2026/hero-1728w.webp 1728w,
    			../imgs/2026/hero-2304w.webp 2304w
    		">
        <img type="image/jpeg" src="../imgs/hero/hero@2x.jpg" onload="this.classList.add('loaded');"
            sizes="(min-width: 1420px) 133.35vw, (min-width: 900px) calc(175.4vw - 675px), (min-width: 720px) calc(180vw - 496px), calc(92vw + 312px)"
            srcset="
    			../imgs/2026/hero576w..jpg 576w,
    			../imgs/2026/hero1152w..jpg 1152w,
    			../imgs/2026/hero1728w..jpg 1728w,
    			../imgs/2026/hero2304w..jpg 2304w
    		" alt="Cryptee Encrypted Docs & Photos">
    </picture>

    <div id="hero-tagline">
        <h2>QUIET CLOUD STORAGE <BR>IN A NOISY WORLD</h2>
        <p>
            for your photos, videos, documents, notes &amp; journals.<br>
            encrypted &amp; private by default
        </p>
    </div>

</article>

<article id="europe-section" class="dark">

    <aside></aside>  <!-- spacing -->

    <section class="media-split">

        <img src="../imgs/other-logos/eu.svg" alt="EU Flag">
        <p class="lowercase">Made in europe, for your privacy<span class="hidden-for-small-screens">, security</span> & peace of mind. <br>We can't read your documents, see your photos or videos, and no one else can either.</p>

    </section>

    <aside></aside>  <!-- spacing -->

</article>
