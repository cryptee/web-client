<article id="index-photos-intro">

    <aside></aside> <!-- spacing -->

    <section class="index-intro-grid">
        <div>
            <h2>ENCRYPTED CLOUD STORAGE <br>FOR YOUR PHOTOS &amp; VIDEOS</h2>
            <p class="lowercase justify">
                Cryptee provides secure, end-to-end encrypted photo and video storage on its
                european cloud to protect your private memories. Your photos &amp;
                videos are encrypted before leaving your device. Only you can see them, and only you decide who else can.

            </p>
        </div>
    </section>

    <aside></aside> <!-- spacing -->

</article>

<article style="padding: 8rem 0" id="index-photos-features">
    <aside></aside> <!-- spacing -->
    <section class="grid-half index-grid-features">

        <div class="feature">
            <p>organize &amp; find things easily</p>
            <p aria-disabled="true">with #hashtags &amp; typo-tolerant search</p>
        </div>

        <picture>
            <source type="image/webp" srcset="../imgs/2026/photos_camera-576w.webp 1x, ../imgs/2026/photos_camera-1152w.webp 2x, ../imgs/2026/photos_camera-1728w.webp 3x, ../imgs/2026/photos_camera-2304w.webp 4x">
            <img    type="image/jpeg"  src="../imgs/2026/photos_camera-576w.jpg" srcset="../imgs/2026/photos_camera-576w.jpg 1x, ../imgs/2026/photos_camera-1152w.jpg 2x, ../imgs/2026/photos_camera-1728w.jpg 3x, ../imgs/2026/photos_camera-2304w.jpg 4x" alt="Cryptee Photos" loading="lazy">
        </picture>

        <div class="feature">
            <p>remember your stories</p>
            <p aria-disabled="true">with descriptions, dates and exif data</p>
        </div>

        <div class="feature">
            <p>hide your private memories</p>
            <p aria-disabled="true">with ghost albums</p>
        </div>

        <b class="full"></b>

        <picture>
            <source type="image/webp" srcset="../imgs/2026/photos_selections-576w.webp 1x, ../imgs/2026/photos_selections-1152w.webp 2x, ../imgs/2026/photos_selections-1728w.webp 3x, ../imgs/2026/photos_selections-2304w.webp 4x">
            <img    type="image/jpeg"  src="../imgs/2026/photos_selections-576w.jpg" srcset="../imgs/2026/photos_selections-576w.jpg 1x, ../imgs/2026/photos_selections-1152w.jpg 2x, ../imgs/2026/photos_selections-1728w.jpg 3x, ../imgs/2026/photos_selections-2304w.jpg 4x" alt="Cryptee Photos" loading="lazy">
        </picture>

        <div class="feature">
            <p>store raw &amp; original photos</p>
            <p aria-disabled="true">cryptee supports all raw files</p>
        </div>

        <div class="feature">
            <p>share albums on your terms</p>
            <p aria-disabled="true">with end-to-end encrypted links</p>
        </div>

        <div class="feature">
            <p>revisit your treasured moments</p>
            <p aria-disabled="true">with favorite photos &amp; videos</p>
        </div>

    </section>
    <aside></aside> <!-- spacing -->
</article>

