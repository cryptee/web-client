    <title>Cryptee | Imprint</title>

</head>

<body class="www-body">

    <!-- $pricing-link = /#pricing -->
    <!-- @import "imports/www/nav.kit" -->

    <article>
        <aside></aside> <!-- spacing -->

        <section class="grid-half">

            <h2 class="full">IMPRINT</h2>

            <b class="full"></b>

            <div class="feature">
                <p>ADDRESS</p>
                <p class="lowercase">crypt.ee, Svartlab OÜ</p>
                <p class="lowercase">Narva mnt 5</p>
                <p class="lowercase">Tallinn, 10117</p>
                <p class="lowercase">Estonia</p>
            </div>

            <div class="feature">
                <p>EMAILS</p>
                <p class="lowercase">
                    <span>general inquiries</span>
                    <span class="right">info @ crypt &bull; ee</span>
                </p>
                <p class="lowercase">
                    <span>legal inquiries</span>
                    <span class="right">legal @ crypt &bull; ee</span>
                </p>
                <p class="lowercase">
                    <span>media/press</span>
                    <span class="right">media @ crypt &bull; ee</span>
                </p>
                <p class="lowercase">
                    <span>security</span>
                    <span class="right">security @ crypt &bull; ee</span>
                </p>
                <p class="lowercase">
                    <span>help</span>
                    <span class="right"><a href="/help">please contact our helpdesk</a></span>
                </p>
            </div>

            <div class="feature full">
                <p>LIABILITY NOTICE</p>
                <p class="lowercase justify">
                    Despite monitoring their contents carefully, we do not assume any liability for the contents of external links. Their operators shall be solely responsible for the contents of the linked external websites. Some type errors may be present. All albums shared using Cryptee Photos are end-to-end encrypted, and it's mathematically &amp; technologically impossible for us to monitor, inspect, scan or review their contents, and thus we do not assume any liability for the contents of these links.
                </p>
            </div>

            <div class="feature">
                <p>TO REPORT ABUSE</p>
                <p>please visit our dedicated page for <a href="/report-abuse">reporting abuse</a></p>
            </div>

            <div class="feature">
                <p>FOR LAW ENFORCEMENT INQUIRIES</p>
                <p>please visit our dedicated page for <a href="/law-enforcement">law enforcement</a></p>
            </div>

            <b class="full"></b>

        </section>

        <aside></aside> <!-- spacing -->

    </article>

    <div style="--r:18"></div>

