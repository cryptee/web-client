    <!-- @import "imports/www/head.kit" -->

    <script type="application/ld+json">
        <!-- @import "schema-corporation.json" -->
    </script>

    <title>Cryptee | Report Abuse</title>

</head>

<body class="www-body">

    <!-- $pricing-link = /#pricing -->
    <!-- @import "imports/www/nav.kit" -->

    <article>
        <aside></aside> <!-- spacing -->

        <section class="grid-half">

            <h2 class="full">REPORT ABUSE</h2>

            <b class="full"></b>

            <div class="full feature">
                <p></p>
                <p>
                    if you see that a cryptee account is being abused or used for abuse, we would like for you to let us know.<br>
                    by abuse, we mean anything that violates our <a href="/terms">terms and conditions</a>, including but not limited to:
                    <br><br>
                    &bull; sending spam / sharing unsolicited album links<br>
                    &bull; impersonation of users or other services<br>
                    &bull; bulk and scripted signups<br>
                    &bull; fraud or other criminal activity<br>
                </p>
            </div>

            <div class="feature">
                <p>TO REPORT ABUSE</p>
                <p>
                    please reach out to us using:<br><br>
                    abuse @ crypt &bull; ee<br><br>
                    your report will be investigated by our team and if the account is found to be in violation of our terms of service, it will be disabled.<br><br>
                </p>
            </div>

            <div class="feature">
                <p>FOR LAW ENFORCEMENT INQUIRIES</p>
                <p>please visit our dedicated page for <a href="/law-enforcement">law enforcement</a></p>
            </div>


            <b class="full"></b>

        </section>

        <aside></aside> <!-- spacing -->

    </article>

    <div style="--r:18"></div>

    <!-- @import "imports/www/footer.kit" -->
</body>

</html>
